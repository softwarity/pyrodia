{
  "name": "pyrodia",
  "version": "0.1.0",
  "description": "PYRODIA - The Fire Must Survive. A pipe-rotation arcade puzzle prototype (HTML5 / TypeScript / Canvas).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "levels:generate": "tsx scripts/generate-levels.ts",
    "levels:validate": "tsx scripts/validate-levels.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
